---
import { sliderChallenge } from '../data/challenges';

const { src, alt, targetX, targetY, pieceSize, tolerance } = sliderChallenge;
---

<section
  id="slider-challenge"
  class="slider-challenge"
  hidden
  aria-labelledby="slider-title"
  data-target-x={targetX}
  data-target-y={targetY}
  data-piece-size={pieceSize}
  data-tolerance={tolerance}
  style={`--target-x: ${targetX * 100}%; --target-y: ${targetY * 100}%; --piece-size: ${pieceSize * 100}%; --puzzle-image: url('${src}')`}
>
  <div class="challenge-heading">
    <div>
      <h2 id="slider-title">Slide the piece into the gap.</h2>
    </div>
  </div>
  <p id="slider-instructions" class="instructions">Drag the slider until the piece fits the gap. Release to verify.</p>

  <div class="puzzle-canvas" aria-hidden="true">
    <img src={src} alt="" width="1600" height="1000" draggable="false" />
    <div class="puzzle-gap"></div>
    <div class="puzzle-piece"></div>
  </div>
  <span class="sr-only">Puzzle image: {alt}</span>

  <div class="slider-control">
    <label for="puzzle-slider">Slide to fit <span aria-hidden="true">→</span></label>
    <input
      id="puzzle-slider"
      type="range"
      min="0"
      max="1000"
      step="1"
      value="0"
      aria-describedby="slider-instructions slider-status"
      aria-valuetext="Piece at the left edge"
    />
  </div>
  <div class="challenge-footer">
    <p id="slider-status" role="status" aria-live="polite">Waiting for alignment.</p>
    <button class="reset-slider" type="button">Reset</button>
  </div>
</section>

<script>
  import { initializeSliderChallenge } from '../lib/slider-challenge';
  initializeSliderChallenge();
</script>

<style>
  .slider-challenge { color: var(--text, #171717); }
  .slider-challenge[hidden] { display: none; }
  .challenge-heading { display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  .eyebrow { margin: 0 0 12px; color: var(--accent, #2563eb); font-size: .75rem; }
  h2 { margin: 0; font-size: clamp(1.4rem, 4vw, 1.9rem); font-weight: 500; letter-spacing: -.04em; }
  .challenge-mark { font-size: 2rem; color: var(--accent, #2563eb); }
  .instructions { margin: 12px 0 22px; color: var(--muted, #555); font-size: .88rem; line-height: 1.6; }
  .puzzle-canvas { position: relative; aspect-ratio: 16 / 10; overflow: hidden; border: 1px solid var(--line, #d4d4d4); background: #000; isolation: isolate; }
  .puzzle-canvas img { display: block; width: 100%; height: 100%; object-fit: fill; user-select: none; }
  .puzzle-gap, .puzzle-piece { position: absolute; top: var(--target-y); width: var(--piece-size); aspect-ratio: 1; clip-path: polygon(0 0, 35% 0, 35% 12%, 45% 20%, 55% 20%, 65% 12%, 65% 0, 100% 0, 100% 35%, 88% 35%, 80% 45%, 80% 55%, 88% 65%, 100% 65%, 100% 100%, 0 100%); }
  .puzzle-gap { left: var(--target-x); background: #08050c; box-shadow: inset 0 0 0 2px #fff; opacity: .94; }
  .puzzle-piece { left: var(--piece-x, 0%); background-image: var(--puzzle-image); background-repeat: no-repeat; box-shadow: inset 0 0 0 2px #fff; filter: drop-shadow(0 2px 5px #000); }
  .canvas-caption { position: absolute; bottom: 12px; left: 12px; padding: 7px 9px; background: #000c; color: #fff; font-size: .65rem; }
  .slider-control { margin-top: 18px; }
  label { display: flex; justify-content: space-between; color: var(--muted, #555); font-size: .85rem; }
  label span { color: var(--accent, #2563eb); }
  input[type='range'] { width: 100%; height: 48px; margin: 8px 0 0; padding: 0; appearance: none; background: transparent; cursor: grab; touch-action: pan-y; }
  input[type='range']:active { cursor: grabbing; }
  input[type='range']::-webkit-slider-runnable-track { height: 8px; background: #e5e7eb; border: 1px solid #aaa; }
  input[type='range']::-moz-range-track { height: 6px; background: #e5e7eb; border: 1px solid #aaa; }
  input[type='range']::-webkit-slider-thumb { appearance: none; width: 48px; height: 40px; margin-top: -17px; border: 1px solid #1d4ed8; border-radius: 3px; background: #2563eb; }
  input[type='range']::-moz-range-thumb { width: 46px; height: 38px; border: 1px solid #1d4ed8; border-radius: 3px; background: #2563eb; }
  input[type='range']:focus-visible { outline: 2px solid var(--accent, #2563eb); outline-offset: 3px; }
  input[type='range']:disabled { cursor: default; opacity: .65; }
  .challenge-footer { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-top: 13px; padding-top: 15px; border-top: 1px solid var(--line, #d4d4d4); }
  #slider-status { margin: 0; color: var(--muted, #555); font-size: .8rem; line-height: 1.5; }
  .slider-challenge[data-state='error'] #slider-status { color: #b91c1c; }
  .slider-challenge[data-state='success'] #slider-status { color: #166534; }
  .reset-slider { min-height: 44px; border: 0; padding: 0 0 0 12px; background: transparent; color: var(--text, #171717); font-size: .85rem; cursor: pointer; white-space: nowrap; }
  .reset-slider span { margin-left: 10px; color: var(--accent, #2563eb); }
  .reset-slider:hover { color: var(--accent, #2563eb); }
  .reset-slider:focus-visible { outline: 2px solid var(--accent, #2563eb); outline-offset: 4px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }
</style>
