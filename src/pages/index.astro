---
import Page from '../layouts/Page.astro';
import ImageChallenge from '../components/ImageChallenge.astro';
import SliderChallenge from '../components/SliderChallenge.astro';
---
<Page title="Not a robot · CAPTCHA demo">
  <main class="selection">
    <h1>Access website</h1>
    <p class="muted">Choose a challenge to verify that you're human.</p>
    <div class="choices">
      <button class="choice" data-challenge="image"><strong>Image grid</strong><span>Select the matching images.</span><span aria-hidden="true">→</span></button>
      <button class="choice" data-challenge="slider"><strong>Slider puzzle</strong><span>Slide the piece into the gap.</span><span aria-hidden="true">→</span></button>
    </div>
    <label class="fullscreen-option"><input type="checkbox" id="fullscreen" checked /> Open fullscreen</label>
    <p id="fullscreen-status" class="muted" role="status"></p>
  </main>
  <dialog id="challenge-dialog" aria-label="Human verification">
    <div class="challenge-top"><span class="muted">Human verification</span><button id="close-challenge" type="button" aria-label="Close challenge">✕</button></div>
    <div id="checkbox-step">
      <button id="human-checkbox" type="button"><span class="checkbox-box" aria-hidden="true"></span><span>I'm not a robot</span></button>
    </div>
    <ImageChallenge />
    <SliderChallenge />
  </dialog>
  <script>
    const dialog = document.querySelector<HTMLDialogElement>('#challenge-dialog');
    const checkbox = document.querySelector<HTMLButtonElement>('#human-checkbox');
    const checkboxStep = document.querySelector<HTMLElement>('#checkbox-step');
    const image = document.querySelector<HTMLElement>('#image-challenge');
    const slider = document.querySelector<HTMLElement>('#slider-challenge');
    const close = document.querySelector<HTMLButtonElement>('#close-challenge');
    const fullscreen = document.querySelector<HTMLInputElement>('#fullscreen');
    const fullscreenStatus = document.querySelector<HTMLElement>('#fullscreen-status');
    let kind = 'image';
    let complete = false;

    function checkCompleted() {
      if (sessionStorage.getItem('captcha-solved')) window.location.replace('/verified/');
    }
    checkCompleted();
    window.addEventListener('pageshow', checkCompleted);

    if (dialog && checkbox && checkboxStep && image && close) {
      document.querySelectorAll<HTMLButtonElement>('[data-challenge]').forEach((button) => {
        button.addEventListener('click', async () => {
          kind = button.dataset.challenge ?? 'image';
          document.dispatchEvent(new Event('challenge-reset'));
          checkboxStep.hidden = false;
          image.hidden = true;
          if (slider) slider.hidden = true;
          if (fullscreen?.checked && !document.fullscreenElement) {
            await document.documentElement.requestFullscreen().catch(() => {
              if (fullscreenStatus) fullscreenStatus.textContent = 'Fullscreen is unavailable. The challenge still works in this window.';
            });
          }
          dialog.showModal();
        });
      });
      checkbox.addEventListener('click', () => {
        checkboxStep.hidden = true;
        const challenge = kind === 'slider' ? slider : image;
        if (challenge) {
          challenge.hidden = false;
          challenge.querySelector<HTMLElement>('input, button')?.focus();
        }
      });
      close.addEventListener('click', () => dialog.close());
      dialog.addEventListener('close', () => {
        if (document.fullscreenElement) document.exitFullscreen();
      });
      document.addEventListener('challenge-state', (event) => {
        if (!(event instanceof CustomEvent) || complete) return;
        const detail: unknown = event.detail;
        if (typeof detail !== 'object' || detail === null || !('state' in detail) || !('kind' in detail)) return;
        if (detail.state === 'success' && detail.kind === kind) {
          complete = true;
          sessionStorage.setItem('captcha-solved', kind);
          window.location.assign('/verified/');
        }
      });
    }
  </script>
  <style>
    .site-header { display: flex; justify-content: space-between; gap: 20px; padding: 24px 36px; border-bottom: 1px solid var(--line); font-size: .85rem; }
    .site-header a { text-decoration: none; font-weight: 600; }
    .selection { max-width: 640px; margin: 12vh auto; padding: 0 24px; }
    h1 { font-size: 2rem; margin: 0 0 12px; }
    .choices { display: grid; gap: 12px; margin: 32px 0 24px; }
    .choice { display: grid; grid-template-columns: 1fr auto; gap: 8px 24px; text-align: left; padding: 22px; border: 1px solid var(--line); border-radius: 5px; background: #fff; color: var(--text); }
    .choice:hover { border-color: var(--text); }
    .choice strong { font-weight: 550; }
    .choice span:first-of-type { grid-row: 2; font-size: .85rem; color: var(--muted); }
    .choice span:last-child { grid-row: 1 / 3; grid-column: 2; align-self: center; }
    .fullscreen-option { display: flex; gap: 10px; align-items: center; font-size: .85rem; }
    .fullscreen-option input { width: 19px; height: 19px; accent-color: var(--accent); }
    .demo-note { margin-top: 40px; font-size: .8rem; }
    #fullscreen-status { font-size: .8rem; }
    dialog { width: min(620px, calc(100% - 32px)); max-height: calc(100dvh - 32px); padding: 24px; border: 1px solid var(--line); border-radius: 5px; background: #fff; color: var(--text); }
    dialog::backdrop { background: #ffffffb3; backdrop-filter: blur(7px); }
    .challenge-top { display: flex; justify-content: space-between; align-items: center; gap: 20px; font-size: .8rem; padding-bottom: 20px; }
    #close-challenge { width: 40px; height: 40px; background: #fff; border: 1px solid var(--line); border-radius: 4px; }
    #checkbox-step { padding: 24px 0; }
    #checkbox-step h2 { margin-top: 0; font-size: 1.5rem; }
    #checkbox-step p { font-size: .85rem; }
    #human-checkbox { display: flex; align-items: center; gap: 20px; width: 100%; min-height: 110px; padding: 24px; border: 1px solid var(--line); border-radius: 4px; background: #fafafa; color: var(--text); text-align: left; }
    .checkbox-box { width: 36px; height: 36px; border: 2px solid #777; background: white; }
    @media (max-width: 480px) { .site-header { padding: 20px; } .selection { margin-top: 8vh; } dialog { padding: 16px; } }
  </style>
</Page>
