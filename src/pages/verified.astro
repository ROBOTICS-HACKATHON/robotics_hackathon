---
import Page from '../layouts/Page.astro';
---
<Page title="Access granted · CAPTCHA demo">
  <main hidden>
    <span class="check" aria-hidden="true">✓</span>
    <p class="muted">Verification complete</p>
    <h1>Access granted.</h1>
    <p>You completed <span id="solved-kind">image</span><span id="solved-variant"></span>. Welcome to the website.</p>
    <button class="button" disabled>Verified</button>
    <button id="restart" class="button primary">Start again</button>
  </main>
  <script>
    import { imageChallenges } from '../data/image-challenges';
    import { sliderChallenges } from '../data/slider-challenges';
    const kind = sessionStorage.getItem('captcha-solved');
    if (kind !== 'image' && kind !== 'slider' && kind !== 'turnstile') {
      window.location.replace('/');
    } else {
      const label = document.querySelector('#solved-kind');
      const main = document.querySelector('main');
      const practice = sessionStorage.getItem('captcha-practice-mode');
      if (label) label.textContent = practice === 'tile' ? 'single tile practice'
        : practice === 'slider' ? 'slider practice'
        : practice === 'checkbox' ? 'checkbox practice'
        : kind === 'turnstile' ? 'Cloudflare Turnstile verification' : `${kind} challenge`;
      const variant = document.querySelector('#solved-variant');
      const index = Number(sessionStorage.getItem('captcha-challenge-index') ?? '0');
      const total = Number(sessionStorage.getItem('captcha-session-total') ?? '0');
      const count = kind === 'image' ? imageChallenges.length : sliderChallenges.length;
      if (total > 0 && Number.isInteger(total)) {
        if (label) label.textContent = `a session of ${total} tasks`;
      } else if (variant && kind !== 'turnstile' && Number.isInteger(index) && index >= 0 && index < count) variant.textContent = ` ${index + 1}`;
      if (main) main.hidden = false;
    }
    document.querySelector('#restart')?.addEventListener('click', () => {
      sessionStorage.removeItem('captcha-solved');
      sessionStorage.removeItem('captcha-session-total');
      window.location.replace('/');
    });
  </script>
  <style>
    main { max-width: 640px; margin: 18vh auto; padding: 24px; }
    h1 { font-size: 2.5rem; margin: 12px 0; }
    .check { display: inline-grid; place-items: center; width: 60px; height: 60px; border: 1px solid #17683c; border-radius: 50%; font-size: 2rem; color: #17683c; }
    .button { margin: 24px 8px 0 0; }
    .button:disabled { color: #17683c; cursor: default; }
  </style>
</Page>
