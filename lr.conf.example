# Copy to lr.conf and edit. Only the robot laptop needs the hardware lines.

# Arms (SO-101; use so100 for SO-100 arms)
ROBOT=so101
FOLLOWER_PORT=/dev/ttyACM0
LEADER_PORT=/dev/ttyACM1
FOLLOWER_ID=my_follower
LEADER_ID=my_leader

# Camera: any device works, the screen markers make it position-independent.
#   USB / RealSense:  CAMERA=/dev/video4          (find the color one with: ./lr cams)
#   Phone, IP Webcam: CAMERA=ipwebcam:192.168.1.23
#   Phone, DroidCam:  CAMERA=droidcam:192.168.1.23
#   Any URL:          CAMERA=http://192.168.1.23:8080/shot.jpg
# Test it with: ./lr cam-test
CAMERA=/dev/video4

# Second camera (optional, e.g. one from the front + one from above) for measuring the tip's height
CAMERA2=
# Camera hover-check before each tap: auto = use CAMERA (+CAMERA2), off = no cameras while tapping
VISION=off
# Colour of the stylus tip marker: pink, green, orange, yellow, blue, or a custom HSV range "h1,s1,v1,h2,s2,v2"
TIP_COLOR=pink
# Width of the screen between the outer corners of the corner markers, in mm (makes tip heights real mm)
SCREEN_WIDTH_MM=300

# What touch-calib holds still after HOME: roll = wrist roll + gripper (wrist flex free),
# wrist = wrist flex + roll + gripper, none = nothing
WRIST_LOCK=roll

# Servo acceleration: lower = smoother, softer starts/stops (LeRobot default is the max, 254 = jerky).
# 50 softer (may lag and overshoot a little), 80 default, 120 snappier, 0 = leave LeRobot's setting.
# Try settings first without the arm: ./lr smooth-preview --accel 80 --speed 1.0
SERVO_ACCEL=80

# Seconds to switch from the terminal to the page before a picture or a tap run starts
# (page and terminal on the same screen). 0 = start right away.
DELAY=5
CAM_WIDTH=640
CAM_HEIGHT=480
FPS=30

# Captcha solver API (./lr solve, ./lr captcha). The Cloudflare values are a Workers AI token of
# your own: keep them here in lr.conf (git-ignored), never commit them.
SOLVER_URL=https://captchasolver.alvaro-camposmndz.workers.dev
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Recording timing (seconds)
EPISODE_TIME=30
RESET_TIME=15

# WSL only: usbipd bus IDs, attached in this order (see `usbipd list` in Windows)
USB_BUSIDS="3-1 3-2 4-1"

# Where calibration + Hugging Face login are kept on this machine.
# The default reuses anything you set up before without Docker.
LR_DATA=$HOME/.cache/huggingface

# Optional: set your Hugging Face username instead of detecting it
# HF_USER=yourname
