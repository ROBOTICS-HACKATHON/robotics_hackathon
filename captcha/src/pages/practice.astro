---
// Arm practice on the real site: the same job as touch/calib.html in "test" mode, but hosted here.
// The robot (./lr practice with TOUCH_WEB set) shows its target via /api/state and reads every touch
// from /api/touches. Open once with ?robot=<ROBOT_KEY>, full-screen (F11), same place as calibration.
import topLeft from '../../../touch/markers/aruco_0.png';
import topRight from '../../../touch/markers/aruco_1.png';
import bottomRight from '../../../touch/markers/aruco_2.png';
import bottomLeft from '../../../touch/markers/aruco_3.png';
const markers = [topLeft, topRight, bottomRight, bottomLeft];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Arm practice</title>
    <script is:inline src="/robot-link.js"></script>
  </head>
  <body>
    {markers.map((m, id) => <img class="marker" src={m.src} data-marker-id={id} alt="" draggable="false" />)}
    <div id="frame"><div id="aim"></div></div>
    <div id="msg"><span id="status">Waiting for the robot…</span><span id="last"></span><span id="link"></span></div>
    <script is:inline>
      (() => {
        const frame = document.getElementById('frame'), aim = document.getElementById('aim');
        const status = document.getElementById('status'), last = document.getElementById('last'), link = document.getElementById('link');
        const on = window.robotLink && window.robotLink.on;
        if (!on) status.textContent = 'Robot link is off: open this page once with ?robot=<your ROBOT_KEY>.';
        document.addEventListener('robot-touch', (e) => {
          const { u, v } = e.detail;
          last.textContent = `${u.toFixed(3)} ${v.toFixed(3)}`;
          const d = document.createElement('div');
          d.className = 'hit'; d.style.left = u * 100 + '%'; d.style.top = v * 100 + '%';
          frame.appendChild(d);
          const hits = frame.querySelectorAll('.hit');
          if (hits.length > 60) hits[0].remove();
        });
        async function poll() {
          try {
            const s = await (await fetch('/api/state', { cache: 'no-store' })).json();
            if (on) status.textContent = s.age != null && s.age < 600 ? (s.msg || 'Robot connected') : 'Waiting for the robot… (./lr practice)';
            if (s.target && s.age < 600) { aim.style.display = 'block'; aim.style.left = s.target[0] * 100 + '%'; aim.style.top = s.target[1] * 100 + '%'; }
            else aim.style.display = 'none';
          } catch { if (on) status.textContent = 'Site API not reachable.'; }
          if (window.robotLink) link.textContent = on ? `sent ${window.robotLink.sent}` + (window.robotLink.failed ? `, failed ${window.robotLink.failed}` : '') : '';
          setTimeout(poll, 500);
        }
        poll();
        addEventListener('contextmenu', (e) => e.preventDefault());
      })();
    </script>
    <style is:global>
      html, body { margin: 0; height: 100%; background: #fff; overflow: hidden; touch-action: none; user-select: none; -webkit-user-select: none; font-family: system-ui, sans-serif; }
      .marker { position: fixed; width: min(14vmin, 160px); height: min(14vmin, 160px); image-rendering: pixelated; pointer-events: none; }
      .marker[data-marker-id='0'] { top: 18px; left: 18px; }
      .marker[data-marker-id='1'] { top: 18px; right: 18px; }
      .marker[data-marker-id='2'] { bottom: 18px; right: 18px; }
      .marker[data-marker-id='3'] { bottom: 18px; left: 18px; }
      #frame { position: fixed; inset: 18px; }
      #aim { position: absolute; display: none; width: 6vmin; height: 6vmin; transform: translate(-50%, -50%); border: 4px solid #f90; border-radius: 50%; pointer-events: none; }
      .hit { position: absolute; width: 10px; height: 10px; transform: translate(-50%, -50%); border-radius: 50%; background: #06c; opacity: .7; pointer-events: none; }
      #msg { position: fixed; left: 50%; top: 33%; transform: translate(-50%, -50%); text-align: center; color: #444; font-size: 2.6vmin; pointer-events: none; max-width: 70vmin; }
      #last { display: block; margin-top: 1vmin; font: 700 5vmin ui-monospace, monospace; color: #06c; }
      #link { display: block; margin-top: 1vmin; font-size: 1.8vmin; color: #999; }
    </style>
  </body>
</html>
