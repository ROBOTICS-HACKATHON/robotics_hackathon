<main id="minesweeper-demo" data-verified="false">
  <p class="eyebrow">THE CLASSIC</p>
  <h1>Minesweeper</h1>
  <p class="muted" role="status">One quick human check before you play.</p>
  <section class="mine-window" aria-label="Minesweeper board">
    <div class="mine-toolbar">
      <span class="counter" aria-label="10 mines">010</span>
      <button id="demo-restart" type="button" aria-label="Restart demo" title="Restart demo">☺</button>
      <span class="counter" aria-label="Elapsed time: 0 seconds">000</span>
    </div>
    <div class="mine-grid" role="group" aria-label="Unopened squares">
      {Array.from({ length: 81 }, (_, index) => <button class="mine-cell" type="button" aria-label={`Row ${Math.floor(index / 9) + 1}, column ${index % 9 + 1}`} />)}
    </div>
  </section>
  <p class="hint muted">9 × 9 · 10 mines</p>
  <label class="hint"><input type="checkbox" id="screen-markers-toggle" /> Camera markers</label>
  <p id="screen-markers-status" class="muted" role="status" hidden></p>
</main>

<style>
  main { width: min(420px, 100%); margin: 8vh auto; padding: 24px; text-align: center; }
  .eyebrow { font-size: .65rem; letter-spacing: .22em; color: var(--muted); }
  h1 { font-size: 2.5rem; margin: 8px 0 16px; }
  [role='status'] { min-height: 54px; font-size: .9rem; }
  .mine-window { padding: 12px; background: #c0c0c0; border: 3px solid; border-color: #eee #777 #777 #eee; }
  .mine-toolbar { display: flex; justify-content: space-between; align-items: center; padding: 8px; margin-bottom: 12px; border: 3px solid; border-color: #777 #eee #eee #777; }
  .counter { padding: 2px 5px; background: #000; color: #ff3939; font: 32px/1 monospace; letter-spacing: 2px; }
  #demo-restart, .mine-cell { border: 3px solid; border-color: #fff #777 #777 #fff; background: #c0c0c0; color: #000; border-radius: 0; }
  #demo-restart { width: 40px; height: 40px; padding: 0; font: 32px/1 monospace; }
  .mine-grid { display: grid; grid-template-columns: repeat(9, minmax(0, 1fr)); border: 3px solid; border-color: #777 #eee #eee #777; }
  .mine-cell { aspect-ratio: 1; min-width: 0; padding: 0; }
  .mine-cell:active, #demo-restart:active { border-color: #777 #fff #fff #777; }
  .hint { font-size: .75rem; margin-top: 20px; }
</style>
