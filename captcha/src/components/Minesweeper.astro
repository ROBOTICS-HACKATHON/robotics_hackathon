<main id="minesweeper-demo" data-verified="false">
  <p class="eyebrow">ROBOT VERIFICATION DEMO</p>
  <h1>Minesweeper</h1>
  <p class="intro muted">A familiar board. One human check.</p>
  <section class="mine-window" aria-label="Minesweeper board">
    <div class="mine-toolbar">
      <span class="counter" aria-label="10 mines">010</span>
      <button id="demo-restart" type="button" aria-label="Restart verification" title="Restart verification"><svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="#ffe873" stroke="currentColor" stroke-width="1.5" /><path d="M8 10h1m6 0h1m-8 4q4 4 8 0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg></button>
      <span class="counter" aria-label="Elapsed time: 0 seconds">000</span>
    </div>
    <div class="mine-grid" role="group" aria-label="Unopened squares">
      {Array.from({ length: 81 }, (_, index) => <button class="mine-cell" type="button" aria-label={`Row ${Math.floor(index / 9) + 1}, column ${index % 9 + 1}`} />)}
    </div>
    <div class="board-meta"><span>BEGINNER</span><span>9 × 9 · 10 mines</span></div>
  </section>
  <p id="demo-status" class="muted" role="status">Human verification will open in a moment.</p>
  <div class="demo-tools">
    <label><input type="checkbox" id="screen-markers-toggle" /> Camera markers</label>
    <a href="/training/">Open training tools <span aria-hidden="true">↗</span></a>
  </div>
  <p id="screen-markers-status" class="muted" role="status" hidden></p>
</main>

<style>
  main { width: min(400px, 100%); margin: clamp(24px, 4vh, 48px) auto; padding: 0 24px 24px; text-align: center; }
  .eyebrow { font-size: .6rem; letter-spacing: .15em; color: var(--muted); margin: 0 0 12px; }
  h1 { font-size: clamp(2rem, 7vw, 2.6rem); margin: 0; }
  .intro { margin: 12px 0 20px; font-size: .85rem; }
  .mine-window { width: min(300px, 100%); margin: auto; padding: 10px; background: #c0c0c0; border: 3px solid; border-color: #eee #777 #777 #eee; }
  .mine-toolbar { display: grid; grid-template-columns: 1fr 36px 1fr; gap: 12px; align-items: center; padding: 7px; margin-bottom: 10px; border: 2px solid; border-color: #777 #eee #eee #777; }
  .counter { justify-self: start; padding: 3px 5px; background: #000; color: #ff3939; font: 26px/1 monospace; letter-spacing: 1px; font-variant-numeric: tabular-nums; }
  .counter:last-child { justify-self: end; }
  #demo-restart, .mine-cell { border: 3px solid; border-color: #fff #777 #777 #fff; background: #c0c0c0; color: #000; border-radius: 0; }
  #demo-restart { display: grid; place-items: center; width: 36px; height: 36px; padding: 0; }
  .mine-grid { display: grid; grid-template-columns: repeat(9, minmax(0, 1fr)); border: 3px solid; border-color: #777 #eee #eee #777; }
  .mine-cell { aspect-ratio: 1; min-width: 0; padding: 0; }
  .mine-cell:active, #demo-restart:active { border-color: #777 #fff #fff #777; }
  .board-meta { display: flex; justify-content: space-between; gap: 12px; margin-top: 10px; color: #292929; font-size: 10px; letter-spacing: .04em; }
  #demo-status { min-height: 34px; margin: 16px 0 12px; font-size: .75rem; }
  .demo-tools { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px 24px; border-top: 1px solid var(--line); padding-top: 16px; font-size: .65rem; }
  .demo-tools label { display: flex; gap: 7px; align-items: center; }
  .demo-tools input { margin: 0; accent-color: var(--accent); }
  .demo-tools a { text-decoration: none; }
  .demo-tools a:hover { text-decoration: underline; }
  #screen-markers-status { font-size: .75rem; }
</style>
