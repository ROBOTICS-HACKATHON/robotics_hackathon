---
import '../styles/global.css';
interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <script is:inline>
      try {
        document.documentElement.dataset.contrast = localStorage.getItem('captcha-contrast') === 'high' ? 'high' : 'normal';
      } catch {
        document.documentElement.dataset.contrast = 'normal';
      }
    </script>
  </head>
  <body><slot /></body>
</html>
